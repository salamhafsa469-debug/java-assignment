Product wise sum without hashmap
import java.util.Scanner;
import java.io.File;

class SalesTotal_ProductWise_NoHM {
    public static void main(String[] args) throws Exception {
        File f = new File("c:\\temp\\SalesEVESession.txt");
        Scanner inp = new Scanner(f);
        inp.nextLine(); // skip header

        // First pass: collect all unique product names
        Scanner inp2 = new Scanner(f);
        inp2.nextLine();

        String[] productNames = new String[100];
        double[] productTotals = new double[100];
        int count = 0;

        while (inp2.hasNextLine()) {
            String line = inp2.nextLine();
            if (line.trim().isEmpty()) continue;

            String[] parts = line.split("\t");
            String prodName = parts[1];
            double qty     = Double.parseDouble(parts[3]);
            double uPrice  = Double.parseDouble(parts[2]);
            double amt     = qty * uPrice;

            // Check if product already exists in our array
            int found = -1;
            for (int i = 0; i < count; i++) {
                if (productNames[i].equals(prodName)) {
                    found = i;
                    break;
                }
            }

            if (found != -1) {
                productTotals[found] += amt; // add to existing
            } else {
                productNames[count] = prodName; // new product
                productTotals[count] = amt;
                count++;
            }
        }

        System.out.println("Product-wise Sales Total:");
        for (int i = 0; i < count; i++) {
            System.out.println(productNames[i] + " --- " + productTotals[i]);
        }
    }
}



