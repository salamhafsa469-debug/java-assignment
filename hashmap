Product wise sum with hashmap
 import java.util.Scanner;
import java.util.HashMap;
import java.util.Map;
import java.io.File;

class SalesTotal_ProductWise_HM {
    public static void main(String[] args) {
        File f = new File("c:\\temp\\SalesEVESession.txt");
        HashMap<String, Double> hm = new HashMap<>();

        try {
            Scanner inp = new Scanner(f);
            inp.nextLine(); // skip header

            while (inp.hasNextLine()) {
                String line = inp.nextLine();
                if (line.trim().isEmpty()) continue;

                String[] parts = line.split("\t");
                String prodName = parts[1];
                double uPrice   = Double.parseDouble(parts[2]);
                double qty      = Double.parseDouble(parts[3]);
                double amt      = qty * uPrice;

                // If product exists, add to it. Otherwise, create new entry.
                hm.put(prodName, hm.getOrDefault(prodName, 0.0) + amt);
            }

        } catch (Exception e) {
            System.out.println("Error: " + e.getMessage());
        }

        System.out.println("Product-wise Sales Total:");
        for (Map.Entry<String, Double> me : hm.entrySet()) {
            System.out.println(me.getKey() + " --- " + me.getValue());
        }
    }
}



          
